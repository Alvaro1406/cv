// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "security", "manage", "contact"]
}

/**
 * ****************** Schema Security *******************
 */
/**
 * User
 */
model User {
  id          String        @id @default(uuid())
  username    String        @unique
  password    String
  firstName   String
  lastName    String
  email       String
  phoneNumber String
  image       String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  sessions    UserSession[]

  @@index([username])
  @@schema("security")
}

/**
 * User Session
 */
model UserSession {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, token, expiresAt])
  @@schema("security")
}

/**
 * ****************** Schema Manage *******************
 */
/**
 * Technical Mastery
 */
model TechnicalMastery {
  id          String   @id @default(uuid())
  name        Json     @default("{}")
  description Json     @default("{}")
  tags        String[]
  image       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name, createdAt])
  @@schema("manage")
}

/**
 * Soft Skills
 */
model SoftSkills {
  id          String   @id @default(uuid())
  name        Json     @default("{}")
  description Json     @default("{}")
  image       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name, createdAt])
  @@schema("manage")
}

/**
 * Work Experience
 */
model WorkExperience {
  id          String     @id @default(uuid())
  name        String
  description Json       @default("{}")
  position    String
  location    String
  startDate   DateTime
  endDate     DateTime?
  projects    Projects[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([id, name, createdAt])
  @@schema("manage")
}

/**
 * Projects
 */
model Projects {
  id               String   @id @default(uuid())
  name             String
  description      Json     @default("{}")
  url              String
  workExperienceId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workExperience WorkExperience @relation(fields: [workExperienceId], references: [id])

  @@index([id, name, createdAt])
  @@schema("manage")
}

/**
 * ****************** Schema Contact *******************
 */
/**
 * Contact
 */
model Contact {
  id           String         @id @default(uuid())
  name         String
  email        String
  subject      String
  message      String
  unread       Boolean        @default(true)
  archived     Boolean        @default(false)
  important    Boolean        @default(false)
  favorite     Boolean        @default(false)
  notification Notifications?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([email, unread, archived, createdAt])
  @@schema("contact")
}

/**
 * Notifications
 */
model Notifications {
  id          String   @id @default(uuid())
  title       String
  description String
  contact     Contact  @relation(fields: [contactId], references: [id])
  contactId   String   @unique
  unread      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([unread, createdAt])
  @@schema("contact")
}
